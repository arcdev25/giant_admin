# --- Admin login (single admin) ---
ADMIN_EMAIL=you@example.com
# Generate with: npm run hash -- "YourPassword"
ADMIN_PASSWORD_HASH=
# Random 32+ char string used to sign the login cookie
SESSION_SECRET=

# --- Database (Supabase, free tier). Leave empty to use a local JSON file in dev. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Company website origin allowed to read jobs (CORS). * = any ---
# One origin, a comma-separated list, or * for any
ALLOWED_ORIGIN=https://devitech.us,https://www.devitech.us
